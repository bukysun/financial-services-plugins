{
  "mcpServers": {
    "fred": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "fred-mcp-server"],
      "env": {
        "FRED_API_KEY": "<your-free-key-from-fred.stlouisfed.org>"
      }
    },
    "yahoo-finance": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "yfinance-mcp"]
    }
  }
}
