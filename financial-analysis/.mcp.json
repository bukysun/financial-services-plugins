{
  "mcpServers": {
    "yahoo-finance": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "yfinance-mcp"]
    },
    "fred": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "fred-mcp-server"],
      "env": {
        "FRED_API_KEY": "<your-free-key-from-fred.stlouisfed.org>"
      }
    },
    "sec-edgar": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "axiom-data-mcp"],
      "env": {
        "SEC_EDGAR_USER_AGENT": "YourName your@email.com"
      }
    }
  }
}
